# Replace these with values from your shared Supabase Cloud Project:
# Dashboard -> Project Settings -> API -> Project URL & Project API Keys (anon public)

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: Mapbox / MapLibre token (if using external satellite basemaps)
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-access-token-optional
