# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://lfuxjipalhwdvhwetbph.supabase.co

# Supabase Anon / Publishable Key (for frontend browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-or-publishable-key-here

# Supabase Secret / Service Role Key (for backend server scripts only - NEVER expose in browser)
SUPABASE_SECRET_KEY=your-secret-key-here

# Optional: Mapbox Token (if using custom satellite basemaps)
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-access-token-optional
